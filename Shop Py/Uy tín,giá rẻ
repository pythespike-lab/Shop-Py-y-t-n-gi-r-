<!DOCTYPE html><html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shop Acc Tự Động</title>
<style>
body{font-family:Arial;margin:0;background:#111;color:#fff}
header{background:#ff5722;padding:15px;text-align:center}
.container{padding:20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}
.card{background:#222;padding:15px;border-radius:10px}
.price{color:#4caf50;font-weight:bold}
button{background:#ff9800;border:none;padding:10px;color:#fff;border-radius:5px;width:100%;cursor:pointer}
button:hover{background:#e68900}
</style>
</head>
<body><header>
<h1>SHOP ACC AUTO</h1>
<p>Mua acc tự động - nhận ngay</p>
</header><div class="container" id="list"></div><script>
let accounts = [
  {name:"Nick Roblox 1", price:100000, user:"user1", pass:"pass1"},
  {name:"Nick Roblox 2", price:120000, user:"user2", pass:"pass2"},
  {name:"Nick LQ VIP", price:200000, user:"user3", pass:"pass3"}
];

function render(){
  let html = "";
  accounts.forEach((acc,i)=>{
    html += `
    <div class="card">
      <h3>${acc.name}</h3>
      <p class="price">${acc.price.toLocaleString()}đ</p>
      <button onclick="buy(${i})">Mua ngay</button>
    </div>`;
  });
  document.getElementById("list").innerHTML = html;
}

function buy(i){
  let acc = accounts[i];
  alert("Thanh toán thành công!\nUser: "+acc.user+"\nPass: "+acc.pass);
}

render();
</script></body>
</html>
